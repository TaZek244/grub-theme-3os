// Triboot — màn hình chào khi khởi động Arch
// Logo hiện dần + phóng nhẹ, quầng sáng "thở", lời chào trượt lên, 3 chấm tải nhấp nháy.

Window.SetBackgroundTopColor(0.027, 0.035, 0.055);
Window.SetBackgroundBottomColor(0.027, 0.035, 0.055);

sw = Window.GetWidth();
sh = Window.GetHeight();
cx = Window.GetX() + sw / 2;
cy = Window.GetY() + sh / 2;

bg = Sprite(Image("background.png").Scale(sw, sh));
bg.SetPosition(Window.GetX(), Window.GetY(), -100);

logo_img  = Image("logo.png");
glow      = Sprite(Image("glow.png"));
logo      = Sprite(logo_img);
mode      = Plymouth.GetMode();
if (mode == "shutdown") {
    greet = Sprite(Image("bye.png"));
    sub   = Sprite(Image("sub_shutdown.png"));
} else if (mode == "reboot") {
    greet = Sprite(Image("bye.png"));
    sub   = Sprite(Image("sub_reboot.png"));
} else {
    greet = Sprite(Image("greet.png"));
    sub   = Sprite(Image("sub.png"));
}
dot_img   = Image("dot.png");

logo_y = cy - 150;
glow.SetPosition(cx - glow.GetImage().GetWidth() / 2, logo_y - glow.GetImage().GetHeight() / 2, 1);
glow.SetOpacity(0);
logo.SetOpacity(0);
greet.SetOpacity(0);
sub.SetOpacity(0);

for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot_img);
    dots[i].SetPosition(cx - 34 + i * 28 - 7, cy + 170, 2);
    dots[i].SetOpacity(0);
}

t = 0;            // số khung hình (~50 khung/giây)
fun ease(x) {     // ease-out: nhanh rồi chậm dần
    x = Math.Clamp(x, 0, 1);
    return 1 - (1 - x) * (1 - x) * (1 - x);
}

fun refresh_callback() {
    t++;

    // 1. Logo: hiện dần và phóng từ 80% lên 100% trong 0.9 giây
    a = ease(t / 45);
    s = 0.8 + 0.2 * a;
    if (t <= 46) {
        w = Math.Int(logo_img.GetWidth() * s);
        logo.SetImage(logo_img.Scale(w, w));
    }
    logo.SetPosition(cx - logo.GetImage().GetWidth() / 2, logo_y - logo.GetImage().GetHeight() / 2, 2);
    logo.SetOpacity(a);

    // 2. Quầng sáng "thở" sau khi logo hiện xong
    if (t > 30) glow.SetOpacity(0.55 + 0.35 * Math.Sin((t - 30) / 30));

    // 3. Lời chào: trễ 0.5 giây, trượt lên 24px và hiện dần
    g = ease((t - 25) / 40);
    greet.SetPosition(cx - greet.GetImage().GetWidth() / 2, cy + 10 + 24 * (1 - g), 2);
    greet.SetOpacity(g);
    k = ease((t - 45) / 40);
    sub.SetPosition(cx - sub.GetImage().GetWidth() / 2, cy + 80 + 16 * (1 - k), 2);
    sub.SetOpacity(k * 0.9);

    // 4. Ba chấm tải nhấp nháy lần lượt
    if (t > 70) {
        for (i = 0; i < 3; i++) {
            dots[i].SetOpacity(0.25 + 0.75 * Math.Abs(Math.Sin((t - 70) / 14 - i * 0.6)));
        }
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// Hệ thống chỉ hiện thông báo dạng chữ khi cần (vd. fsck): đặt dưới chấm tải
msg = Sprite();
fun message_callback(text) {
    if (text == "") {
        msg.SetOpacity(0);
    } else {
        msg.SetImage(Image.Text(text, 0.54, 0.58, 0.65));
        msg.SetPosition(cx - msg.GetImage().GetWidth() / 2, cy + 220, 3);
        msg.SetOpacity(1);
    }
}
Plymouth.SetMessageFunction(message_callback);
